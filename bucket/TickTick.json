{
    "version": "8.2.4.0",
    "description": "(Chinese version) A Todo list, checklist and task manager app.",
    "homepage": "https://dida365.com/",
    "license": {
        "identifier": "Proprietary",
        "url": "https://dida365.com/tos"
    },
    "architecture": {
        "64bit": {
            "url": "https://cdn.dida365.cn/download/win64/dida_win_setup_release_x64_8240.exe",
            "hash": "29481787f61b2893dd6acd5141f0c3348c8bc2d42b02290a6d99c2875c694d23"
        },
        "32bit": {
            "url": "https://cdn.dida365.cn/download/win/dida_win_setup_release_x86_8240.exe",
            "hash": "73865727acd3686da88c7401e953c4fc7fe5f5d389dc8b04af767030c00423af"
        }
    },
    "innosetup": true,
    "shortcuts": [
        [
            "TickTick.exe",
            "滴答清单"
        ]
    ],
    "pre_install": [
        "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name $bucket) scripts/AirUtils.psm1)",
        "RedirectDirectory \"$env:APPDATA\\Tick_Tick\" \"$persist_dir\\APPDATA\\Tick_Tick\"",
        "Remove-Module -Name AirUtils"
    ],
    "uninstaller": {
        "script": [
            "if ($cmd -eq 'uninstall') {",
            "    Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name $bucket) scripts/AirUtils.psm1)",
            "    RemoveJunction \"$env:APPDATA\\Tick_Tick\"",
            "    Remove-Module -Name AirUtils",
            "}"
        ]
    },
    "checkver": {
        "url": "https://pull.dida365.com/windows/release_note.json",
        "jsonpath": "$.version"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://cdn.dida365.cn/download/win64/dida_win_setup_release_x64_$cleanVersion.exe"
            },
            "32bit": {
                "url": "https://cdn.dida365.cn/download/win/dida_win_setup_release_x86_$cleanVersion.exe"
            }
        }
    }
}
