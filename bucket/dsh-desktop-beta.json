{
    "version": "2.0.10-beta.1",
    "description": "Open-source Windows and macOS desktop client built on DeepSeek Harness. (Beta channel)",
    "homepage": "https://github.com/anywhere-labs/dsh-desktop",
    "license": "MIT",
    "notes": [
        "Beta channel build. It keeps its own app data under %APPDATA%\\DSH Desktop Beta, but shares the DSH home in %USERPROFILE%\\.dsh with the stable edition.",
        "DSH Desktop ships its own updater which downloads and runs the official NSIS installer; that can install a second copy under %LOCALAPPDATA%\\Programs.",
        "When the app offers an update, pick Later and run 'scoop update dsh-desktop-beta' so Scoop keeps owning the installed version."
    ],
    "url": "https://github.com/anywhere-labs/dsh-desktop/releases/download/v2.0.10-beta.1/DSH-Desktop-Beta-2.0.10-beta.1-x64-Setup.exe#/dl.7z",
    "hash": "ab58a5d4cbca24e5d3bf20dc66b226ce7bc1bad741e5405dfa75177babbf16a2",
    "pre_install": [
        "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name $bucket) scripts/AirUtils.psm1)",
        "# electron-builder NSIS: the application files are packed in $PLUGINSDIR\\app-64.7z",
        "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
        "Remove-Item \"$dir\\`$PLUGINSDIR\", \"$dir\\`$R0\", \"$dir\\Uninstall DSH Desktop Beta.exe\", \"$dir\\uninstallerIcon.ico\" -Force -Recurse -ErrorAction SilentlyContinue",
        "# Redirect data directory to persist",
        "RedirectDirectory \"$env:APPDATA\\DSH Desktop Beta\" \"$persist_dir\\APPDATA\\DSH Desktop Beta\"",
        "Remove-Module -Name AirUtils"
    ],
    "shortcuts": [
        [
            "DSH Desktop Beta.exe",
            "DSH Desktop Beta"
        ]
    ],
    "uninstaller": {
        "script": [
            "if ($cmd -eq 'uninstall') {",
            "    Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name $bucket) scripts/AirUtils.psm1)",
            "    RemoveJunction \"$env:APPDATA\\DSH Desktop Beta\"",
            "    Remove-Module -Name AirUtils",
            "}"
        ]
    },
    "checkver": {
        "url": "https://api.github.com/repos/anywhere-labs/dsh-desktop/releases",
        "regex": "\"tag_name\":\"v([\\d.]+-beta\\.\\d+)\""
    },
    "autoupdate": {
        "url": "https://github.com/anywhere-labs/dsh-desktop/releases/download/v$version/DSH-Desktop-Beta-$version-x64-Setup.exe#/dl.7z"
    }
}
